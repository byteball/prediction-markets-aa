{
	doc_url: "https://prophet.ooo/prediction-markets-tokenless.json",
	getters: `{
		$lib_aa_const = "4NWNNEO5BD5EFIFRRLEEK2E6RUYBJIMP";

		$get_reserve = ($yes_amount, $no_amount, $draw_amount) => ($lib_aa_const||'')#2.$get_reserve(this_address, $yes_amount, $no_amount, $draw_amount);

		$get_exchange_result = ($yes_amount, $no_amount, $draw_amount) => ($lib_aa_const||'')#11.$get_exchange_result(this_address, $yes_amount, $no_amount, $draw_amount);

		$get_result_for_buying_by_type = ($type, $reserve_amount) => ($lib_aa_const||'')#11.$get_result_for_buying_by_type(this_address, $type, $reserve_amount);

		$get_supplies = () => {
			var['supplies'] OTHERWISE {yes: 0, no: 0, draw: 0}
		};

		$get_user_balance = ($address) => {
			var['balance_' || $address] OTHERWISE {yes: 0, no: 0, draw: 0}
		};
 	}`,
	init: `{
		$lib_aa = $lib_aa_const || '';

		// params
		$oracle = params.oracle;
		require($oracle AND is_valid_address($oracle), "oracle isn't valid");

		$comparison = params.comparison OTHERWISE "==";
		require($comparison == "==" OR $comparison == ">" OR $comparison == ">=" OR $comparison == "<" OR $comparison == "<=" OR $comparison == "!=", "operation is unknown");

		$feed_name = params.feed_name OTHERWISE '';
		require(length($feed_name) > 0 AND $feed_name != "none", "feed_name isn't valid");

		$reserve_asset = params.reserve_asset OTHERWISE 'base';
		require(asset[$reserve_asset].exists, "no such asset: " || $reserve_asset);

		$allow_draw = params.allow_draw;

		$datafeed_draw_value = params.datafeed_draw_value OTHERWISE 'none';
		$datafeed_value = params.datafeed_value;

		require(exists($datafeed_value), "datafeed_value does not exist");

		$event_date = params.event_date OTHERWISE 0;
		require(is_integer($event_date) AND $event_date > 0, "event_date must be integer");

		$waiting_period_length = params.waiting_period_length OTHERWISE 5 * 24 * 3600;
		require(is_integer($waiting_period_length) AND $waiting_period_length >= 0, "waiting period must be integer");

		$quiet_period = params.quiet_period OTHERWISE 0;
		require(is_integer($quiet_period) AND $quiet_period >= 0, "quiet period must be integer");

		$issue_fee = exists(params.issue_fee) ? params.issue_fee : 0.01;
		require($issue_fee >= 0 AND $issue_fee < 1, "issue_fee isn't valid");

		$redeem_fee = exists(params.redeem_fee) ? params.redeem_fee : 0.02;
		require($redeem_fee >= 0 AND $redeem_fee < 1, "redeem_fee isn't valid");
	
		// helpers
		$result = var['result']; // yes/no/draw

		// amounts by outcome: positive = buy, negative = redeem
		$amounts_in = {
			yes: trigger.data.yes_amount OTHERWISE 0,
			no: trigger.data.no_amount OTHERWISE 0,
			draw: trigger.data.draw_amount OTHERWISE 0
		};

		$has_sale = $amounts_in.yes < 0 OR $amounts_in.no < 0 OR $amounts_in.draw < 0;

		$end_of_waiting_period = $event_date + $waiting_period_length;
		$trading_open = timestamp <= $event_date - $quiet_period OR timestamp >= $end_of_waiting_period;

		$network_fee = ($reserve_asset == 'base') ? 10000 : 0;
		
		$reserve = var['reserve'] OTHERWISE 0;
		$reserve_amount = trigger.output[[asset=$reserve_asset]];

		$type = trigger.data.type OTHERWISE false;
		
		$supplies = $get_supplies();
		$user_balance = $get_user_balance(trigger.address);

		$sum_by_outcome = ($a, $b) => {yes: $a.yes + $b.yes, no: $a.no + $b.no, draw: $a.draw + $b.draw};

		$to = trigger.data.to OTHERWISE trigger.address;

		if (trigger.data.to AND !is_valid_address(trigger.data.to))
			bounce("bad to address");

		if ($type) {
			require($type == 'yes' OR $type == 'no' OR $type == 'draw', "unknown type");
		}
	}`,
	messages: {
		cases: [
			{ // transfer tokens to another address
				if: `{trigger.data.transfer}`,
				init: `{
					require(trigger.data.to AND $to != trigger.address, "to address is required");
					require(($reserve_asset == 'base' AND $reserve_amount == $network_fee) OR ($reserve_asset != 'base' AND $reserve_amount == 0), "should not send a reserve");

					require(is_integer($amounts_in.yes) AND $amounts_in.yes >= 0, "invalid yes_amount");
					require(is_integer($amounts_in.no) AND $amounts_in.no >= 0, "invalid no_amount");
					require(is_integer($amounts_in.draw) AND $amounts_in.draw >= 0, "invalid draw_amount");
					require($amounts_in.yes + $amounts_in.no + $amounts_in.draw > 0, "nothing to transfer");

					require($amounts_in.yes <= $user_balance.yes, "not enough yes balance");
					require($amounts_in.no <= $user_balance.no, "not enough no balance");
					require($amounts_in.draw <= $user_balance.draw, "not enough draw balance");
				}`,
				messages: [
					{
						app: 'state',
						state: `{
							var['balance_' || trigger.address] = $sum_by_outcome($user_balance, {yes: -$amounts_in.yes, no: -$amounts_in.no, draw: -$amounts_in.draw});
							var['balance_' || $to] = $sum_by_outcome($get_user_balance($to), $amounts_in);

							response['event'] = json_stringify({
								type: 'transfer',
								user: trigger.address,
								to: $to,
								yes_amount: $amounts_in.yes,
								no_amount: $amounts_in.no,
								draw_amount: $amounts_in.draw,
								user_balance: $get_user_balance(trigger.address),
								to_balance: $get_user_balance($to)
							});
						}`
					},
				]
			},
			{ // mint or redeem tokens
				if: `{!exists(trigger.data.claim_profit) AND !exists(trigger.data.add_liquidity) AND (($reserve_amount > $network_fee AND (trigger.data.yes_amount OR trigger.data.no_amount OR trigger.data.draw_amount OR trigger.data.type)) OR $has_sale)}`,
				init: `{
					require($allow_draw OR !exists(trigger.data.draw_amount), "draw asset does not exist");

					if ((trigger.data.yes_amount OR trigger.data.no_amount OR trigger.data.draw_amount) AND trigger.data.type) {
						bounce("both type and amount");
					}
					
					$min_expected_amount = trigger.data.min_expected_amount OTHERWISE 0;

					if ($type AND (!is_integer($min_expected_amount) OR $min_expected_amount < 0)) {
						bounce("invalid min_expected_amount");
					}

					if (!$trading_open) {
						$error = "the trading period is closed";
						return;
					}

					if ($result) {
						$error = "result already exists";
						return;
					}
				
					if ($type) {

						require($reserve_amount > $network_fee, 'You sent no reserve');

						$res = $lib_aa#11.$get_result_for_buying_by_type(this_address, $type, $reserve_amount);

						$amounts = {
							yes: $type == 'yes' ? $res.amount : 0,
							no: $type == 'no' ? $res.amount : 0,
							draw: $type == 'draw' ? $res.amount : 0
						};

						if ($res.amount < $min_expected_amount) {
							$error = "amount less than minimum";
							return;
						}

					} else {
						// positive = buy, negative = sell from the sender's balance
						$amounts = $amounts_in;

						require(is_integer($amounts.yes), "invalid yes_amount");
						require(is_integer($amounts.no), "invalid no_amount");
						require(is_integer($amounts.draw), "invalid draw_amount");

						require(-$amounts.yes <= $user_balance.yes, "not enough yes balance");
						require(-$amounts.no <= $user_balance.no, "not enough no balance");
						require(-$amounts.draw <= $user_balance.draw, "not enough draw balance");

						$res = $lib_aa#11.$get_exchange_result(this_address, $amounts.yes, $amounts.no, $amounts.draw);
						$payout = floor($res.gross_payout + $reserve_amount - $res.reserve_needed - $res.fee - $network_fee);

						if ($payout < 0) {
							$error = "expected reserve amount: " || ($res.reserve_needed + $res.fee + $network_fee);
							return;
						}
					}

				}`,
				messages: [
					{ // return the change (if any) or pay out the redeemed reserve
						if: "{($payout AND $payout > 0) OR $error}",
						app: 'payment',
						payload: {
							asset: `{$reserve_asset}`,
							outputs: [
								{address: "{$to}", amount: "{$error ? $reserve_amount - $network_fee : $payout}"},
							]
						}
					},
					{
						app: 'state',
						state: `{
							if ($error) {
								// a sale has nothing to refund, hard bounce; a purchase gets its reserve back by the payment above
								if ($has_sale)
									bounce($error);
								response['error'] = $error;
								return;
							}

							response['next_reserve'] = $res.new_reserve  OTHERWISE 0;
							response['next_coef'] = $res.next_coef OTHERWISE 1;

							response['yes_amount'] = $amounts.yes;
							response['no_amount'] = $amounts.no;
							response['draw_amount'] = $amounts.draw;

							response['yes_price'] = $res.yes_price;
							response['no_price'] = $res.no_price;
							response['draw_price'] = $res.draw_price;

							var['reserve'] = $res.new_reserve;
							var['coef'] = $res.next_coef;

							if ($res.fee > 0){
								response['fee'] = $res.fee;
							}

							response['arb_profit_tax'] = $res.arb_profit_tax;

							$new_supplies = $sum_by_outcome($supplies, $amounts);
							var['supplies'] = $new_supplies;

							// sold tokens are debited from the sender, bought tokens are credited to $to
							var['balance_' || trigger.address] = $sum_by_outcome($user_balance, {yes: min($amounts.yes, 0), no: min($amounts.no, 0), draw: min($amounts.draw, 0)});
							var['balance_' || $to] = $sum_by_outcome($get_user_balance($to), {yes: max($amounts.yes, 0), no: max($amounts.no, 0), draw: max($amounts.draw, 0)}); // if $to == trigger.address, reads the value written just above

							response['event'] = json_stringify({
								type: 'trade',
								user: trigger.address,
								to: $to,
								yes_amount: $amounts.yes,
								no_amount: $amounts.no,
								draw_amount: $amounts.draw,
								reserve_amount: $reserve_amount - $network_fee,
								payout: $payout OTHERWISE 0,
								fee: $res.fee,
								arb_profit_tax: $res.arb_profit_tax,
								reserve: $res.new_reserve,
								coef: $res.next_coef,
								supplies: $new_supplies,
								yes_price: $res.yes_price,
								no_price: $res.no_price,
								draw_price: $res.draw_price,
								user_balance: $get_user_balance(trigger.address),
								to_balance: trigger.data.to ? $get_user_balance($to) : false
							});

							require($res.new_reserve <= balance[$reserve_asset] - $payout, "new reserve state var is greater than the AA balance in the reserve asset"); // balance[] does not reflect the already sent payments, that's why we subtract $payout
							require($res.new_reserve - $reserve <= $reserve_amount, "reserve grows by more than the added reserve amount");
						}`
					},
				]
			},
			{ // add liquidity
				if: `{trigger.data.add_liquidity AND $reserve_amount > $network_fee}`,
				init: `{
					require(!$has_sale, "negative amounts are not accepted when adding liquidity");

					$gross_reserve_delta = $reserve_amount - $network_fee; // gross, because it includes the fee and tax
					
					if ($trading_open AND !$result) {

						if ($supplies.yes + $supplies.no + $supplies.draw == 0) {
							$yes_amount_ratio = trigger.data.yes_amount_ratio OTHERWISE 0;
							require($yes_amount_ratio >= 0, 'yes ratio isnt valid');

							if ($allow_draw) {
								$no_amount_ratio = trigger.data.no_amount_ratio OTHERWISE 0;
								require($no_amount_ratio >= 0, 'no ratio isnt valid');

								$draw_amount_ratio = 1 - $yes_amount_ratio - $no_amount_ratio;

								require($draw_amount_ratio >= 0, 'ratio isnt valid');
							} else {
								$no_amount_ratio = 1 - $yes_amount_ratio;

								require($no_amount_ratio >= 0, 'yes ratio isnt valid');
							}

							require($yes_amount_ratio >= 0 AND $no_amount_ratio >= 0 AND $yes_amount_ratio + $no_amount_ratio + $draw_amount_ratio == 1, 'yes_amount_ratio + no_amount_ratio + draw_amount_ratio must be equal 1');

							$amounts = {
								yes: floor($gross_reserve_delta * sqrt($yes_amount_ratio)),
								no: floor($gross_reserve_delta * sqrt($no_amount_ratio)),
								draw: $allow_draw ? floor($gross_reserve_delta * sqrt($draw_amount_ratio)) : 0
							};

						} else {
							$ratio = ($gross_reserve_delta + $reserve) / $reserve;

							$amounts = {
								yes: floor($ratio * $supplies.yes - $supplies.yes),
								no: floor($ratio * $supplies.no - $supplies.no),
								draw: floor($ratio * $supplies.draw - $supplies.draw)
							};
						}
					} else {
						$hasError = true;
					}
				}`,
				messages: [
					{
						if: "{$hasError}",
						app: 'payment',
						payload: {
							asset: `{$reserve_asset}`,
							outputs: [
								{address: "{$to}", amount: "{$reserve_amount - $network_fee}"}
							]
						}
					},
					{
						if: "{!$hasError}",
						app: 'state',
						state: `{
							$new_supplies = $sum_by_outcome($supplies, $amounts);
							var['supplies'] = $new_supplies;
							var['balance_' || $to] = $sum_by_outcome($get_user_balance($to), $amounts);

							$target_new_reserve = $get_reserve($new_supplies.yes, $new_supplies.no, $new_supplies.draw);

							$new_reserve = var['reserve'] + $gross_reserve_delta;

							$next_coef = (var['coef'] OTHERWISE 1) * $new_reserve / $target_new_reserve;

							var['coef'] = $next_coef;
							var['reserve'] += $gross_reserve_delta;

							// for stats
							response['yes_amount'] = $amounts.yes;
							response['no_amount'] = $amounts.no;
							response['draw_amount'] = $amounts.draw;

							response['next_reserve'] = var['reserve'];
							response['next_coef'] = $next_coef;
							response['fee'] = 0;
							
							$new_den = sqrt($new_supplies.yes * $new_supplies.yes + $new_supplies.no * $new_supplies.no + $new_supplies.draw * $new_supplies.draw);
							
							$new_yes_price = $next_coef * ($new_supplies.yes / $new_den);
							$new_no_price = $next_coef * ($new_supplies.no / $new_den);
							$new_draw_price = $next_coef * ($new_supplies.draw / $new_den);

							response['yes_price'] = $new_yes_price;
							response['no_price'] = $new_no_price;
							response['draw_price'] = $new_draw_price;

							response['event'] = json_stringify({
								type: 'add_liquidity',
								user: trigger.address,
								to: $to,
								yes_amount: $amounts.yes,
								no_amount: $amounts.no,
								draw_amount: $amounts.draw,
								reserve_amount: $gross_reserve_delta,
								reserve: $new_reserve,
								coef: $next_coef,
								supplies: $new_supplies,
								yes_price: $new_yes_price,
								no_price: $new_no_price,
								draw_price: $new_draw_price,
								to_balance: trigger.data.to ? $get_user_balance($to) : false
							});
						}`
					},
				]
			},
			{ // commit result
				if: `{trigger.data.commit AND !$result}`,
				init: `{
					$current_datafeed_value = data_feed[[oracles=$oracle, feed_name=$feed_name, ifnone=false]];

					require(exists($current_datafeed_value), "data_feed not found");
					require(timestamp > $event_date, "trading period has not ended yet");

					if ($comparison == '>')
						$datafeed_comparison = $current_datafeed_value > $datafeed_value;
					else if ($comparison == '<')
						$datafeed_comparison = $current_datafeed_value < $datafeed_value;
					else if ($comparison == '!=')
						$datafeed_comparison = $current_datafeed_value != $datafeed_value;
					else if ($comparison == '==')
						$datafeed_comparison = $current_datafeed_value == $datafeed_value;
					else if ($comparison == '>=')
						$datafeed_comparison = $current_datafeed_value >= $datafeed_value;
					else if ($comparison == '<=')
						$datafeed_comparison = $current_datafeed_value <= $datafeed_value;
					else
						bounce('Comparison operator not found');
					
					if ($datafeed_comparison) {
						$res = 'yes';
					} else if ($allow_draw AND $current_datafeed_value == $datafeed_draw_value) {
						$res = 'draw';
					} else {
						$res = 'no';
					}

				}`,
				messages: [
					{
						app: 'state',
						state: `{
							var['result'] = $res;
							response['messages'] = "The result is committed";
							response['result'] = $res;
							response['event'] = json_stringify({type: 'commit', user: trigger.address, result: $res, datafeed_value: $current_datafeed_value});
						}`
					},
				]
			},
			{ // claim profit
				if: `{trigger.data.claim_profit}`,
				init: `{
					require(($reserve_asset == 'base' AND $reserve_amount == $network_fee) OR ($reserve_asset != 'base' AND $reserve_amount == 0), "should not send a reserve");

					require($result, "no results yet");

					$winner_amount = $user_balance[$result];

					$winner_supply =  $supplies[$result];

					require($winner_supply > 0, "BUG winner supply = " || $winner_supply);
					require($winner_amount > 0, "no winning tokens on the balance");

					$payout = floor($winner_amount / $winner_supply * $reserve);
				}`,
				messages: [
						{
						if: "{ $payout > 0 }",
						app: 'payment',
						payload: {
							asset: `{$reserve_asset}`,
							outputs: [
								{address: "{$to}", amount: "{$payout}"},
							]
						}
					},
					{
						app: 'state',
						state: `{
							response["profit"] = $payout;

							$supplies[$result] = $supplies[$result] - $winner_amount;
							$user_balance[$result] = 0;

							var['supplies'] = $supplies;
							var['reserve'] -= $payout;
							var['balance_' || trigger.address] = $user_balance;

							response['event'] = json_stringify({
								type: 'claim_profit',
								user: trigger.address,
								to: $to,
								result: $result,
								amount: $winner_amount,
								profit: $payout,
								reserve: $reserve - $payout,
								supplies: $supplies,
								user_balance: $user_balance
							});
						}`
					},
				]
			}
		]
	}
}